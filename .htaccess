# Astro Static Site Routing & Security
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---- Legacy service-area route migration ----
  # Keep old indexed/bookmarked legacy URLs as one-hop canonical 301s.
  RewriteRule ^locations/?$ https://www.kwikeylocksmith.com/service-areas/ [R=301,L,NE,NC]
  RewriteRule ^locations/([^/]+)/?$ https://www.kwikeylocksmith.com/service-areas/$1/ [R=301,L,NE,NC]
  RewriteRule ^locations/([^/]+)/([^/]+)/?$ https://www.kwikeylocksmith.com/service-areas/$1/$2/ [R=301,L,NE,NC]

  # ---- Legacy article route migration ----
  RewriteRule ^blog/emergency-lockout-what-to-do-philadelphia/?$ https://www.kwikeylocksmith.com/blog/emergency-lockout-what-to-do-delaware-nearby-pa/ [R=301,L,NE,NC]

  # ---- Force HTTPS + www canonical domain ----
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.kwikeylocksmith\.com$ [NC]
  RewriteRule ^ https://www.kwikeylocksmith.com%{REQUEST_URI} [R=301,L,NE]

  # Ensure index.html is the entry point
  RewriteRule ^index\.html$ - [L]

  # Expose static utility pages at their clean trailing-slash routes.
  RewriteRule ^404/?$ /404.html [L]
  RewriteRule ^500/?$ /500.html [L]

  # Thank-you is server-gated through /thank-you/index.php.
  RewriteRule ^thank-you/index\.html$ /thank-you/ [R=302,L,NE]

  # NOTE: No catch-all rewrite. Apache natively returns 404 for
  # non-existent files/directories. ErrorDocument below intercepts
  # that 404 and serves our custom page WITH the correct HTTP 404 status.
</IfModule>

# Custom 404 error page (served with HTTP 404 status by Apache)
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 502 /500.html
ErrorDocument 503 /500.html
ErrorDocument 504 /500.html

# Basic Security Headers (Fallback if PHP fails to send them)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://maps.googleapis.com https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://www.clarity.ms https://scripts.clarity.ms https://s.ksrndkehqnwntyxlhgto.com blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://maps.googleapis.com https://maps.gstatic.com https://www.clarity.ms https://c.clarity.ms https://c.bing.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://maps.googleapis.com https://stats.g.doubleclick.net https://api.smtp2go.com https://www.clarity.ms https://c.clarity.ms https://k.clarity.ms https://w.clarity.ms https://o.clarity.ms https://www.google.com https://www.recaptcha.net; frame-src 'self' https://www.google.com https://www.recaptcha.net https://www.googletagmanager.com https://maps.googleapis.com; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests;"

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(css|js|mjs|webp|png|jpe?g|gif|svg|ico|woff2?|webmanifest)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Prevent OG images from being indexed as standalone pages
  <FilesMatch "^og/.*\.png$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

# Block access to sensitive files
<FilesMatch "\.(env|log|bak|sql)$">
  Require all denied
</FilesMatch>

# Block direct access to API config
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>

# Block access to rate limit data
<IfModule mod_rewrite.c>
  RewriteRule ^api/\.rate_limit/ - [F,L]
  RewriteRule ^api/\.thank_you_tokens/ - [F,L]
  RewriteRule ^api/\.lead_events/ - [F,L]
</IfModule>

# Block access to hidden files (except .htaccess)
<FilesMatch "^\.(?!htaccess)">
  Require all denied
</FilesMatch>

# Prevent directory listing
Options -Indexes

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>
